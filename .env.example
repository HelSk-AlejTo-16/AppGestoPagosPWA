# Base de datos PostgreSQL (opcional en local si usas PostgreSQL local por defecto)
# Para conectar a Supabase (usar Session Pooler IPv4 en puerto 5432):
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_PARAMS=?sslmode=require&prepareThreshold=0


